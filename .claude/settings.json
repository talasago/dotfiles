{
  "language": "japanese",
  "attribution": {
    "commit": ""
  },
  "model": "sonnet",
  "outputStyle": "Simple",
  "alwaysThinkingEnabled": true,
  "theme": "dark-daltonized",
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-test-skill.sh"
          }
        ]
      }
    ]
  }
}
